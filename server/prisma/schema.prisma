generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppType {
  BALA_STORIES
  ISLAMIC_TALES
}

model Blogger {
  id           String      @id @default(uuid())
  login        String      @unique
  passwordHash String
  name         String
  promoCode    String      @unique
  apps         AppType[]
  createdAt    DateTime    @default(now())
  promoUses    PromoUse[]
  talePromos   TalePromo[]
}

enum PromoAction {
  ENTERED
  PURCHASED
}

model PromoUse {
  id              String      @id @default(uuid())
  blogger         Blogger     @relation(fields: [bloggerId], references: [id], onDelete: Cascade)
  bloggerId       String
  action          PromoAction
  app             AppType
  externalUserId  String?
  // Транзакция магазина для событий, пришедших от Fairy (серверная атрибуция).
  // Уникальность = дедуп: повторная нотификация Apple или ретрай доставки не
  // задваивает награду блогеру. NULL у старых строк и у клиентского легаси —
  // в Postgres NULL друг с другом не конфликтуют.
  transactionId   String?     @unique
  createdAt       DateTime    @default(now())
}

/// Реферальный промокод блогера: открывает выбранный набор сказок и закрепляет
/// человека за блогером. Код бесплатный — сказки здесь причина его ввести.
model TalePromo {
  id        String         @id @default(uuid())
  code      String         @unique
  taleIds   String[]       // слаги из каталога Fairy, выбранные галочками
  blogger   Blogger?       @relation(fields: [bloggerId], references: [id])
  bloggerId String?
  app       AppType        @default(BALA_STORIES)
  maxUses   Int?           // null = безлимит
  useCount  Int            @default(0)
  label     String?
  /// Дата, после которой код перестаёт активироваться. null = бессрочно
  /// (так у всех кодов, заведённых до появления колонки). Уже открытые сказки
  /// живут в Fairy и не гаснут: срок ограничивает ввод, а не подарок.
  expiresAt DateTime?
  createdAt DateTime       @default(now())
  uses      TalePromoUse[]
}

/// Кто уже вводил этот код. Уникальность пары чинит разрыв между двумя базами:
/// сайт погасил использование, Fairy упал — повторный ввод того же кода тем же
/// человеком не тратит второе использование.
model TalePromoUse {
  id             String    @id @default(uuid())
  promo          TalePromo @relation(fields: [promoId], references: [id], onDelete: Cascade)
  promoId        String
  externalUserId String
  app            AppType
  createdAt      DateTime  @default(now())

  @@unique([promoId, externalUserId])
}

/// Правила награждения, по которым строится отчёт. Хранится решение, а не
/// результат: смена окна с 30 на 90 дней пересчитывает все прошлые месяцы.
model ReferralSettings {
  id              String   @id @default("default")
  attributionDays Int?     // null = бессрочно
  showRenewals    Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model PremiumPromo {
  id           String    @id @default(uuid())
  code         String    @unique
  durationDays Int
  label        String?
  maxUses      Int?      // null = unlimited (reusable reviewer code); 1 = single-use
  useCount     Int       @default(0)
  used         Boolean   @default(false)
  usedBy       String?
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
}

// ─────────────────── Конкурс для авторов (UGC) ───────────────────
// Кабинет участника: вход через Google, личный промокод, рейтинг по активациям.
// Активации живут не здесь, а в Fairy (referral_bindings) — тут только коды,
// участники и зафиксированные итоги.

/// Сроки и порог — настройка, а не константа в коде: даты сдвигаются, и правка
/// сроков не должна быть деплоем. finalizedAt проставлено = итоги заморожены.
model Contest {
  id             String    @id @default("ugc-2026-09")
  title          String
  startsAt       DateTime
  endsAt         DateTime
  minActivations Int       @default(30)
  finalizedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  results        ContestResult[]
}

/// Участник живёт вне конкурса: код выдаётся один раз и не меняется, потому что
/// его уже назвали в опубликованных видео. Привязка к конкретному конкурсу —
/// это окно дат при подсчёте, а не колонка здесь.
model Participant {
  id           String    @id @default(uuid())
  /// null у тех, кто вошёл по ссылке, а не через Google.
  googleSub    String?   @unique
  email        String    @unique
  name         String?
  avatarUrl    String?

  // Анкета. Код выдаётся при её сохранении, поэтому "вошёл, но не заполнил" —
  // законное состояние, а не сбой.
  // Ники в соцсетях. Заполнять все не нужно — хватает одного: автор снимает
  // не везде, а нам нужен тот контакт, по которому его реально найти.
  instagram    String?
  tiktok       String?
  telegram     String?
  /// У YouTube ссылка, а не ник: канал по @-нику опознать труднее.
  youtube      String?
  phone        String?

  code         String?   @unique
  /// TalePromo, созданный под этот код: без него код не сработает в приложении.
  talePromoId  String?   @unique

  /// Идентификатор последней выданной ссылки для входа. Сверка с ним и делает
  /// ссылку одноразовой: вошедший её гасит, переслать дальше уже нечего.
  inviteTokenId String?

  disqualified Boolean   @default(false)
  dqReason     String?

  createdAt    DateTime  @default(now())
  codeIssuedAt DateTime?
  lastSeenAt   DateTime  @default(now())

  results      ContestResult[]
}

/// Снимок итогов. Отдельная таблица, потому что активации живут в чужой базе:
/// связку может снять поддержка, и "зафиксированное" 7 место молча превратилось
/// бы в 8-е. После фиксации страница читает отсюда и Fairy не спрашивает.
model ContestResult {
  contestId     String
  participantId String
  contest       Contest     @relation(fields: [contestId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  code          String
  activations   Int
  rank          Int
  qualified     Boolean
  prizeTier     Int?
  prizeAmount   Int?
  frozenAt      DateTime    @default(now())

  @@id([contestId, participantId])
  @@index([contestId, rank])
}

// ─────────────────── Розыгрыш в Telegram-боте ───────────────────
// Здесь участник — зритель, а не автор: он ставит приложение, вводит личный код
// и получает билеты. Победители не по местам, а случайным взвешенным выбором.
// Активации и оплаты, как и у конкурса, живут в Fairy и спрашиваются по коду.

/// Кампания розыгрыша. Правила билетов и призы — настройка, а не константа в
/// коде: состав билетов на старте не определён, и его смена не должна быть
/// деплоем. `published = false` — бот отвечает только админам из TG_ADMIN_IDS,
/// поэтому кампанию можно собрать и прогнать до того, как объявлены призы.
model TgCampaign {
  id           String    @id @default("tg-2026-09")
  title        String
  startsAt     DateTime
  endsAt       DateTime
  /// [{ id: "install", tickets: 1, enabled: true, cap?: 5 }, ...]
  rules        Json
  /// [{ tier: 1, amount: 100000, count: 1 }, ...] — фонд считается отсюда.
  prizeGrid    Json
  /// Что открывает код участника. Пусто = взять из TG_TALE_IDS либо из
  /// последнего блогерского кода (та же лестница, что у конкурса).
  taleIds      String[]
  /// Канал для правила `channel`; бот должен быть в нём администратором.
  channelId    String?
  published    Boolean   @default(false)
  /// Публикуется ДО розыгрыша (хэш списка участников), seed — после.
  seedHash     String?
  seed         String?
  finalizedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  participants TgParticipant[]
  snapshots    TgTicketSnapshot[]
  winners      TgWinner[]
}

/// Участник привязан к кампании: следующая кампания выдаст тому же человеку
/// новый код, а прошлый останется в истории со своими активациями.
model TgParticipant {
  campaign     TgCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId   String
  id           String     @id @default(uuid())

  /// Telegram id хранится строкой: он не участвует в арифметике, зато BigInt
  /// ломает JSON.stringify в каждом ответе админки.
  tgUserId     String
  username     String?
  firstName    String?
  languageCode String?

  /// ?start=<источник> — по чьей ссылке пришёл (блогер, канал, реклама).
  source       String?
  /// ?start=ref_<tgUserId> — кто пригласил; билет засчитывается пригласившему
  /// только после подтверждённой активации приглашённого.
  invitedBy    TgParticipant?  @relation("TgInvites", fields: [invitedById], references: [id])
  invitedById  String?
  invited      TgParticipant[] @relation("TgInvites")

  code         String?    @unique
  /// TalePromo под этот код: без него код не сработает в приложении.
  talePromoId  String?    @unique

  /// Проставляет синхронизация с Fairy: активация кода и первая оплата по нему.
  activatedAt  DateTime?
  paidAt       DateTime?
  channelOk    Boolean    @default(false)

  disqualified Boolean    @default(false)
  dqReason     String?
  /// Спрашивается только у победителей — реквизиты для выплаты.
  phone        String?

  createdAt    DateTime   @default(now())
  codeIssuedAt DateTime?
  lastSeenAt   DateTime   @default(now())

  snapshots    TgTicketSnapshot[]
  wins         TgWinner[]

  @@unique([campaignId, tgUserId])
  @@index([campaignId, activatedAt])
  @@index([invitedById])
}

/// Билеты, замороженные перед розыгрышем. Как и у конкурса — снимок, потому что
/// активации живут в чужой базе: снятая поддержкой связка не должна задним
/// числом менять уже проведённый розыгрыш.
model TgTicketSnapshot {
  campaign      TgCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId    String
  participant   TgParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantId String

  code          String
  tickets       Int
  /// { install: 1, subscription: 5, friend: 4 } — из чего сложились билеты.
  breakdown     Json
  frozenAt      DateTime      @default(now())

  @@id([campaignId, participantId])
  @@index([campaignId])
}

model TgWinner {
  campaign      TgCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId    String
  participant   TgParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantId String

  prizeTier     Int
  prizeAmount   Int
  notifiedAt    DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  @@id([campaignId, participantId])
  @@index([campaignId, prizeTier])
}
